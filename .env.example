# Self-Hosted Environment Variables Configuration

# GEMINI_API_KEY: (Optional) Google Gemini API key used for generating AI Executive News Briefing Summaries.
# Obtain one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# PORT: The port on which the server listens (defaults to 3000 inside the container)
PORT=3000

